#!/usr/bin/env python3
"""Push SOLMAR COVER (gta6-cover-art-01) to bingx12/gta6-cover-art-01 as its
first commit. REST API only via gh.py — no git push, no token exposure."""
import json
import subprocess
import sys
from pathlib import Path

GH = ["python3", "/home/hatch/workspace/custom-connectors/custom.github/bin/gh.py"]
OWNER, REPO = "bingx12", "gta6-cover-art-01"
ROOT = Path("/home/hatch/workspace/makefun/gta6-cover-art-01-bot")
EXCLUDE_DIRS = {"out", "out2", "out3", ".git"}


def run(*args):
    p = subprocess.run(GH + list(args), capture_output=True, text=True)
    try:
        out = json.loads(p.stdout)
    except json.JSONDecodeError:
        print("NON-JSON from", args, p.stdout, p.stderr)
        sys.exit(1)
    if p.returncode != 0 or "error" in out:
        print("FAILED", args, json.dumps(out)[:500])
        sys.exit(1)
    return out


def main():
    files = sorted(
        p for p in ROOT.rglob("*")
        if p.is_file()
        and p.relative_to(ROOT).parts[0] not in EXCLUDE_DIRS
    )
    entries = []
    for f in files:
        rel = str(f.relative_to(ROOT))
        blob = run("create-blob", "--owner", OWNER, "--repo", REPO, "--file", str(f))
        entries.append({"path": rel, "mode": "100644", "type": "blob", "sha": blob["sha"]})
        print("blob", rel, blob["sha"][:12])
    tree = run("create-tree", "--owner", OWNER, "--repo", REPO,
               "--entries", json.dumps(entries))
    print("tree", tree["sha"])
    commit = run("create-commit", "--owner", OWNER, "--repo", REPO,
                 "--message", "SOLMAR COVER — GTA-style multi-panel cover art maker (make.fun gta6-cover-art-01)",
                 "--tree", tree["sha"])
    print("commit", commit["sha"])
    ref = run("update-ref", "--owner", OWNER, "--repo", REPO,
              "--ref", "heads/main", "--sha", commit["sha"])
    print("ref", ref.get("object", {}).get("sha"), ref.get("ref"))
    print("COMMIT_SHA=" + commit["sha"])


if __name__ == "__main__":
    main()
